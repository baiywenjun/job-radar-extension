{
  "manifest_version": 3,
  "name": "岗位雷达 · JD 结构化记录仪",
  "version": "0.1.0",
  "description": "在招聘网站岗位详情页把 JD 结构化留存，按强/弱信号词打分，识别疑似伪岗、外包岗与僵尸岗。个人求职辅助工具，不做批量采集。",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://*.zhipin.com/*",
    "https://*.maimai.cn/*",
    "https://*.liepin.com/*",
    "https://*.iguopin.com/*"
  ],
  "background": {
    "service_worker": "src/background/sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhipin.com/*",
        "https://*.maimai.cn/*",
        "https://*.liepin.com/*",
        "https://*.iguopin.com/*"
      ],
      "js": [
        "src/common/util.js",
        "src/common/rules.js",
        "src/content/adapters.js",
        "src/content/extract.js",
        "src/content/panel.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "岗位雷达 · 查看本地岗位库",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
