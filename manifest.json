{
  "manifest_version": 3,
  "name": "岗位雷达 · JD 结构化记录仪",
  "version": "0.3.0",
  "description": "用你自己的判定标准 + 模型 API 探测岗位真伪，并在本地留存 JD 原文。个人求职辅助工具，不做批量采集。",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.zhipin.com/*",
    "https://*.maimai.cn/*",
    "https://*.liepin.com/*",
    "https://*.iguopin.com/*",
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhipin.com/*",
        "https://*.maimai.cn/*",
        "https://*.liepin.com/*",
        "https://*.iguopin.com/*"
      ],
      "js": [
        "src/common/util.js",
        "src/common/rules.js",
        "src/content/adapters.js",
        "src/content/extract.js",
        "src/content/diagnose.js",
        "src/common/verdict.js",
        "src/content/panel.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "岗位雷达 · 判定标准与岗位库",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
